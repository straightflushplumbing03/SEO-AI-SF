# Copy to .env and fill in. NEVER commit .env.
# These are consumed via environment variables by scripts/db.py, gen_case_study.py, etc.

# GitHub token used to open PRs against the site repo.
GITHUB_TOKEN=

# target website repo
SFGE_SITE_REPO=straightflushplumbing03/-Up2datewebsiteseo

# optional overrides for local / offline testing (see docs/OPERATIONS.md)
SFGE_SITE_CLONE_URL=
SFGE_PUSH_URL=

# phase-3+: keyword API (DataForSEO OR SerpApi) — requires Lance's explicit sign-off (guardrail 6)
DATAFORSEO_USER=
DATAFORSEO_PASS=

# phase-2+: review-request flow (Twilio) — requires Lance's explicit sign-off
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# phase-5: AI answer-engine probes used in Module E (SerpApi or direct providers)
SERPAPI_KEY=